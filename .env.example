# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Configure via Settings > Secrets in AI Studio or your hosting environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server & Runtime Environment
PORT=3000
NODE_ENV="development"
# ENV: Set to "development" to allow local testing without App Check headers; set to "production" when deploying.
ENV="development"

# Gemini Cloud Model (Node server defaults to gemini-4-hydrogen)
GEMINI_CLOUD_MODEL="gemini-4-hydrogen"

# Firebase Project & Firestore Database (client config is in firebase-applet-config.json)
FIREBASE_PROJECT_ID="project2-8e03b"
FIRESTORE_DATABASE_ID="ai-studio-08f7a945-2d04-41c5-9050-766e990ad306"

# Optional comma-separated allowed CORS origins for external deployments
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
